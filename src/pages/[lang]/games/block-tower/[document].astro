---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { legalDocuments } from '@/data/legal';
import LegalText from '@/components/LegalText.astro';
import LocalizedText from '@/components/LocalizedText.astro';
import { copy, localeUrl, locales, type LegalKind, type Locale } from '@/i18n';
export function getStaticPaths() {
  return locales.flatMap((lang) =>
    ['privacy-policy', 'terms-of-service'].map((document) => ({
      params: { lang, document },
    })),
  );
}
const locale = Astro.params.lang as Locale;
const document = Astro.params.document as LegalKind;
const t = copy[locale];
const policy = legalDocuments[document];
const content = policy.locales[locale];
const effectiveDate = new Intl.DateTimeFormat(
  locale === 'fa' ? 'fa-IR' : 'en-GB',
  {
    dateStyle: 'long',
    timeZone: 'UTC',
  },
).format(new Date(`${policy.effectiveDate}T00:00:00Z`));
---

<BaseLayout
  locale={locale}
  path={`games/block-tower/${document}`}
  title={`${content.title} | Block Tower | ${t.brand}`}
  description={content.introduction[0]}
  sampleContent={false}
  game
>
  <article class="legal-document shell">
    <a class="breadcrumb" href={localeUrl(locale, 'games/block-tower')}>
      <span class="back-icon" aria-hidden="true">
        ↶
      </span>
      <span>
        <LocalizedText text={t.backToGame} />
      </span>
    </a>
    <header class="document-heading">
      <p class="document-game" lang="en" dir="ltr" translate="no">
        Block Tower
      </p>
      <h1>{content.title}</h1>
    </header>
    <p class="document-date">
      {t.effectiveDate}:{' '}
      <time datetime={policy.effectiveDate}>{effectiveDate}</time>
    </p>
    <div class="document-body">
      {content.introduction.map((paragraph) => (
        <p class="document-intro">
          <LegalText text={paragraph} />
        </p>
      ))}
      {content.sections.map((section) => (
        <section id={section.id} aria-labelledby={`${section.id}-title`}>
          <h2 id={`${section.id}-title`}>{section.title}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>
              <LegalText text={paragraph} />
            </p>
          ))}
          {section.bullets.length > 0 && (
            <ul>
              {section.bullets.map((bullet) => (
                <li>
                  <LegalText text={bullet} />
                </li>
              ))}
            </ul>
          )}
        </section>
      ))}
    </div>
    <nav class="document-related" aria-label={t.legalTitle}>
      <a
        href={localeUrl(
          locale,
          `games/block-tower/${document === 'privacy-policy' ? 'terms-of-service' : 'privacy-policy'}`,
        )}
      >
        {document === 'privacy-policy' ? t.terms : t.privacy}
      </a>
      <a href={localeUrl(locale, 'games/block-tower')}>
        <span>
          <LocalizedText text={t.backToGame} />
        </span>
      </a>
    </nav>
  </article>
</BaseLayout>
