---
import { assetUrl, copy, localeUrl, type Locale } from '@/i18n';
interface Props {
  locale: Locale;
  game?: boolean;
  sampleContent?: boolean;
}
const { locale, game = false, sampleContent = true } = Astro.props;
const t = copy[locale];
---

<footer class="site-footer shell">
  <div class="footer-main">
    <div class="footer-signature">
      <img
        src={assetUrl('images/joojik-mark.svg')}
        width="28"
        height="32"
        alt=""
        loading="lazy"
      />
      <span>{t.footerLine}</span>
    </div>
    <nav class="footer-links" aria-label={game ? t.legalTitle : t.navLabel}>
      {game ? (
        <>
          <a href={localeUrl(locale, 'games/block-tower/privacy-policy')}>
            {t.privacy}
          </a>
          <a href={localeUrl(locale, 'games/block-tower/terms-of-service')}>
            {t.terms}
          </a>
        </>
      ) : (
        <a href={localeUrl(locale, 'games/block-tower')}>Block Tower</a>
      )}
    </nav>
  </div>
  <div class="footer-bottom">
    <small>
      © {new Date().getUTCFullYear()}{' '}
      <bdi lang="en" translate="no">
        Joojik Studio
      </bdi>
    </small>
    {sampleContent && (
      <small>
        {t.sampleLabel}. {t.sampleNote}
      </small>
    )}
  </div>
</footer>
