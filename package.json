{
  "name": "joojik-studio-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/build.test.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write src tests astro.config.mjs site.config.mjs playwright.config.ts README.md",
    "format:check": "prettier --check src tests astro.config.mjs site.config.mjs playwright.config.ts README.md"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/almarai": "^5.3.0",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "cheerio": "^1.2.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3"
  }
}
